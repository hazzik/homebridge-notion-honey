{
  "name": "homebridge-notion-honey",
  "displayName": "Notion Hub",
  "version": "0.1.3",
  "description": "A Homebridge plugin that shows Notion and Honey Smart Home sensors in Apple Home: doors, windows, leaks, temperature and smoke alarms.",
  "main": "dist/index.js",
  "license": "LGPL-3.0-or-later",
  "homepage": "https://github.com/hazzik/homebridge-notion-honey#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hazzik/homebridge-notion-honey.git"
  },
  "bugs": {
    "url": "https://github.com/hazzik/homebridge-notion-honey/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hazzik"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "supports-matter",
    "notion",
    "honey",
    "leak",
    "contact",
    "temperature"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.0.0"
  },
  "files": [
    "dist/",
    "config.schema.json",
    "README.md"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "^2.3.0",
    "@types/node": "^22",
    "eslint": "^10.15.0",
    "homebridge": "^2",
    "jose": "^6.2.18",
    "prettier": "^3.10.1",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "scripts": {
    "build": "yarn types && vite build",
    "prepack": "yarn build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@eneris/push-receiver": "^4.4.0",
    "jwt-decode": "^4.0.0"
  }
}
